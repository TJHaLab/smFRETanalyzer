<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>39.0.0</version>
        <relativePath />
    </parent>

    <groupId>taekjip-ha-lab</groupId>
    <artifactId>smFRETAnalyzer</artifactId>
    <version>1.3.0-SNAPSHOT</version>

    <name>Single Molecule FRET analysis</name>
    <description>This plugin is used to analyze two channel single molecule FRET data.</description>
    <url>https://github.com/TJHaLab/smFRETanalyzer</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>taekjip-ha-lab</name>
        <url>https://sites.google.com/site/taekjiphalab</url>
    </organization>
    <licenses>
        <license>
            <name>Unlicense</name>
            <url>https://unlicense.org/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>HazenBabcock</id>
            <name>Hazen Babcock</name>
        </developer>
    </developers>
    <contributors>
        <contributor>
            <name>None</name>
        </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>Image.sc Forum</name>
            <archive>https://forum.image.sc/tags/imagej</archive>
        </mailingList>
    </mailingLists>

    <scm>
        <connection>scm:git:git://github.com/TJHaLab/smFRETanalyzer</connection>
        <developerConnection>scm:git:git@github.com:TJHaLab/smFRETanalyzer</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/TJHaLab/smFRETanalyzer</url>
    </scm>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/TJHaLab/smFRETanalyzer/issues</url>
    </issueManagement>
    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/TJHaLab/smFRETanalyzer/actions</url>
    </ciManagement>

    <properties>
        <main-class>smFRETAnalyzer</main-class>
        <license.licenseName>unlicense</license.licenseName>
        <license.copyrightOwners>N/A</license.copyrightOwners>
        <license.projectName>ImageJ software for multidimensional image processing and analysis.</license.projectName>

        <!--
        Tests run headless, and that is not optional. Every plugin here captures
        GraphicsEnvironment.isHeadless() into a final field at construction and takes the
        ui.show() branch when it is false - on a UIService the tests never inject, so a
        windowed test run reaches a null service instead of skipping the display.

        The memory bump is over pom-scijava's -Xmx512m, which is not enough for a synthetic
        movie held as float alongside its background estimate. This property is appended after
        that flag in the inherited argLine, and the last -Xmx wins.
        -->
        <scijava.surefire.args>-Xmx2g -Djava.awt.headless=true</scijava.surefire.args>
    </properties>

    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/repositories/public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>imagej</artifactId>
        </dependency>
        <dependency>
            <groupId>net.imglib2</groupId>
            <artifactId>imglib2-ij</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.14.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.6.0-jre</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>cisd</groupId>
            <artifactId>jhdf5</artifactId>
            <version>19.04.0</version>
            <scope>compile</scope>
        </dependency>

        <!--
        The Bessel function behind the Airy PSF and the Levenberg-Marquardt behind its fit.
        Version managed by pom-scijava. Already on the classpath transitively through ImageJ,
        and declared here anyway because smFRETPSF uses it directly - a transitive dependency
        is one a BOM bump is free to drop.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
        </dependency>

        <!--
        JUnit 5 rather than 4 for @ParameterizedTest: most of what is worth pinning here is
        stated as a property that holds across spot sizes 1.0 to 3.0, and that reads as one
        parameterized case rather than a hand-rolled loop whose first failure hides the rest.

        The three artifacts are listed separately because pom-scijava manages api, engine and
        params but *not* the junit-jupiter aggregate, so depending on the aggregate is a
        missing-version error rather than the one-liner it looks like it should be.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

